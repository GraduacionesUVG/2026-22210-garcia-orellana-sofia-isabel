{
  "name": "antropologia-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ejecutar.cjs dev demo",
    "demo": "node ejecutar.cjs dev demo",
    "conectado": "node ejecutar.cjs dev conectado",
    "build": "node ejecutar.cjs build conectado",
    "start": "node ejecutar.cjs start conectado",
    "start:demo": "node ejecutar.cjs start demo",
    "test": "npm run test:unit && npm run test:demo && npm run test:conexion && npm run test:modos",
    "test:unit": "cd frontend && jest --config jest.frontend.config.cjs --runInBand",
    "test:demo": "node --test demo/pruebas/*.test.mjs",
    "test:conexion": "node --test conexion/*.test.mjs",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test:ui": "npm run build && npm run test:ui:build-existente",
    "test:ui:build-existente": "cd frontend && node scripts/pruebas-ui.cjs",
    "test:modos": "node --test frontend/servicios/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.136",
    "ai": "6.0.134",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.33",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.24",
    "jest": "30.2.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
